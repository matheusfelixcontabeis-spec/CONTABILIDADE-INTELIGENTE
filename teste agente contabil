    def test_ingestao_arquivo_invalido(self, session_id_teste, mock_llm_engine, 
                                       mock_chromadb_client, tmp_path):
        """Testa erro ao tentar ingestar arquivo inexistente ou inválido."""
        with patch('backend.agentes.contador.chromadb.PersistentClient', return_value=mock_chromadb_client):
            agente = self.AgenteContadorTestable(session_id_teste, llm_engine=mock_llm_engine)
            
            resultado = agente.ingestar_plano_contas("arquivo_inexistente.csv")
            assert resultado["sucesso"] is False
            assert "erro" in resultado
            
            arquivo_txt = tmp_path / "arquivo.txt"
            arquivo_txt.write_text("conteudo invalido")
