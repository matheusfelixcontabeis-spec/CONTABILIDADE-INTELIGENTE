class TestIngestaoPlanoContas:
    """Testes para ingestão de Planos de Contas (CSV/Excel)."""
    
    # Subclasse para teste que isola componentes externos
    class AgenteContadorTestable(AgenteContador):
        def _configurar_embeddings(self):
            return Mock()
            
    def test_ingestao_csv_sucesso(self, session_id_teste, plano_contas_arquivo_csv, 
                                  mock_llm_engine, mock_chromadb_client):
        """Testa ingestão bem sucedida de CSV."""
        # Patch apenas do cliente Chroma, já que embeddings estão isolados na subclasse
        with patch('backend.agentes.contador.chromadb.PersistentClient', return_value=mock_chromadb_client):
            agente = self.AgenteContadorTestable(session_id_teste, llm_engine=mock_llm_engine)
