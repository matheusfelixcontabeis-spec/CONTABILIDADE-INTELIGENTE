            assert resultado["qtd_contas"] > 0
    
    def test_ingestao_excel_sucesso(self, session_id_teste, plano_contas_mock, 
                                    mock_llm_engine, mock_chromadb_client, tmp_path):
        """Testa ingestão bem sucedida de Excel."""
        with patch('backend.agentes.contador.chromadb.PersistentClient', return_value=mock_chromadb_client):
            arquivo_excel = tmp_path / "plano_teste.xlsx"
            plano_contas_mock.to_excel(arquivo_excel, index=False)
            
